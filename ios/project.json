{
  "name": "NoScroll",
  "options": {
    "minimumXcodeGenVersion": "2.44.0",
    "deploymentTarget": {
      "iOS": "17.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1",
      "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
      "CODE_SIGN_STYLE": "Automatic",
      "NOSCROLL_BUNDLE_PREFIX": "com.noscroll.ios",
      "NOSCROLL_APP_GROUP": "group.com.noscroll.ios",
      "MARKETING_VERSION": "0.1.0",
      "CURRENT_PROJECT_VERSION": "1",
      "ENABLE_USER_SCRIPT_SANDBOXING": "YES"
    }
  },
  "packages": {
    "NoScrollCore": {
      "path": "Core"
    }
  },
  "targets": {
    "NoScrollIOS": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        {
          "path": "App"
        },
        {
          "path": "Shared"
        },
        {
          "path": "Configuration/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(NOSCROLL_BUNDLE_PREFIX)",
          "INFOPLIST_FILE": "Configuration/App-Info.plist",
          "CODE_SIGN_ENTITLEMENTS": "Configuration/NoScroll.entitlements",
          "APPLICATION_EXTENSION_API_ONLY": "NO"
        }
      },
      "dependencies": [
        {
          "package": "NoScrollCore"
        },
        {
          "target": "NoScrollBroadcast",
          "embed": true
        },
        {
          "target": "NoScrollShieldAction",
          "embed": true
        },
        {
          "target": "NoScrollShieldConfiguration",
          "embed": true
        }
      ]
    },
    "NoScrollBroadcast": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        {
          "path": "Broadcast"
        },
        {
          "path": "Shared"
        },
        {
          "path": "Configuration/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(NOSCROLL_BUNDLE_PREFIX).broadcast",
          "INFOPLIST_FILE": "Configuration/Broadcast-Info.plist",
          "CODE_SIGN_ENTITLEMENTS": "Configuration/NoScroll.entitlements",
          "APPLICATION_EXTENSION_API_ONLY": "YES"
        }
      },
      "dependencies": [
        {
          "package": "NoScrollCore"
        }
      ]
    },
    "NoScrollShieldAction": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        {
          "path": "ShieldAction"
        },
        {
          "path": "Shared/AppEnvironment.swift"
        },
        {
          "path": "Shared/ProfileRepository.swift"
        },
        {
          "path": "Shared/ProtectionCoordinator.swift"
        },
        {
          "path": "Configuration/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(NOSCROLL_BUNDLE_PREFIX).shieldaction",
          "INFOPLIST_FILE": "Configuration/ShieldAction-Info.plist",
          "CODE_SIGN_ENTITLEMENTS": "Configuration/NoScroll.entitlements",
          "APPLICATION_EXTENSION_API_ONLY": "YES"
        }
      },
      "dependencies": [
        {
          "package": "NoScrollCore"
        }
      ]
    },
    "NoScrollShieldConfiguration": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        {
          "path": "ShieldConfiguration"
        },
        {
          "path": "Configuration/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "$(NOSCROLL_BUNDLE_PREFIX).shieldconfiguration",
          "INFOPLIST_FILE": "Configuration/ShieldConfiguration-Info.plist",
          "CODE_SIGN_ENTITLEMENTS": "Configuration/NoScroll.entitlements",
          "APPLICATION_EXTENSION_API_ONLY": "YES"
        }
      },
      "dependencies": []
    },
    "NoScrollNativeTests": {
      "type": "bundle.unit-test",
      "platform": "iOS",
      "sources": [
        {
          "path": "NativeTests"
        }
      ],
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": "YES",
          "PRODUCT_BUNDLE_IDENTIFIER": "$(NOSCROLL_BUNDLE_PREFIX).tests",
          "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/NoScrollIOS.app/NoScrollIOS",
          "BUNDLE_LOADER": "$(TEST_HOST)"
        }
      },
      "dependencies": [
        {
          "target": "NoScrollIOS"
        },
        {
          "package": "NoScrollCore"
        }
      ]
    }
  },
  "schemes": {
    "NoScrollIOS": {
      "build": {
        "targets": {
          "NoScrollIOS": "all",
          "NoScrollNativeTests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "NoScrollNativeTests"
        ],
        "gatherCoverageData": true
      }
    }
  }
}
