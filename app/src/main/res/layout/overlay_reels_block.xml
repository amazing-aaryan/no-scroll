<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF171615"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:padding="32dp">

    <ImageView
        android:id="@+id/blocker_destination_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/noscroll_logo_transparent_128"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FBF8F0"
        android:textSize="32sp"
        android:fontFamily="serif"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/blocker_destination_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blocker_reader_name"
        android:textColor="#C9C2B8"
        android:textSize="16sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/blocker_change_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/blocker_change_app"
        android:textColor="#FBF8F0"
        android:backgroundTint="#36322D" />

</LinearLayout>
